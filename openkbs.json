{
  "projectId": "82cb5e264803",
  "region": "eu-central-1",
  "backend": "elastic",
  "postgres": false,
  "storage": { "cloudfront": "media" },
  "mqtt": false,
  "functions": [
    { "name": "api", "runtime": "nodejs24.x", "memory": 1024, "timeout": 300, "schedule": "cron(5 * * * ? *)" }
  ],
  "site": "./site",
  "redirects": {
    "canonicalHost": "apex",
    "cleanUrls": true,
    "rules": [
      { "from": "/d/*", "to": "/api?share=:splat", "status": 301 }
    ]
  },
  "notFound": "/404.html"
}
